PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Em produção, defina FRONTEND_URL com a URL do front (Netlify).
# Origens https em *.netlify.app e *.vercel.app já são aceitas no CORS.
JWT_SECRET=change-me
WEBHOOK_SECRET=change-me-webhook

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/noma?retryWrites=true&w=majority

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Noma CRM <noreply@noma.com>"
AGENDA_NOTIFY_EMAIL=lainovais@nomacria.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# IA do dossiê. Gemini é gratuito: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternativa gratuita: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Pago: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
