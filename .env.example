PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Em produção, defina FRONTEND_URL com a URL do front (Netlify).
# Origens https em *.netlify.app e *.vercel.app já são aceitas no CORS.
JWT_SECRET=change-me

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/noma?retryWrites=true&w=majority

# Cloudinary (fotos e arquivos): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
